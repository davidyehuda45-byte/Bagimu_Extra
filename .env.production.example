# Contoh konfigurasi PRODUCTION. Salin menjadi .env di server lalu isi.
# JANGAN commit file .env asli ke git.

APP_NAME="Bagimu Extra"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://eskul.sekolah.sch.id
APP_TIMEZONE=Asia/Jakarta

# Generate baru di server, JANGAN pakai key dari laptop dev:
#   php artisan key:generate
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database: pilih salah satu ---
# Opsi A: SQLite (paling mudah, tanpa server DB)
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/bagimu/database/database.sqlite  (path absolut file sqlite)

# Opsi B: MySQL (disarankan bila trafik tinggi / multi-server)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bagimu
# DB_USERNAME=bagimu
# DB_PASSWORD=isi-password-kuat

# File-based agar tidak butuh worker/Redis di hosting biasa.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true karena production memakai HTTPS:
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync = tanpa worker antrean (aplikasi ini tidak memakai job antrean).
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.sekolah.sch.id
MAIL_PORT=587
MAIL_USERNAME=noreply@sekolah.sch.id
MAIL_PASSWORD=isi-password-email
MAIL_FROM_ADDRESS="noreply@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Paksa semua URL buatan aplikasi memakai https (setelah SSL aktif).
APP_FORCE_HTTPS=true

# Wajib diisi bila di belakang Traefik / reverse proxy:
TRUSTED_PROXIES=*

# Variabel untuk Traefik & Docker Compose
ORIGIN=eskul.sekolah.sch.id
PORT=80

VITE_APP_NAME="${APP_NAME}"
