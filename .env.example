APP_NAME="Bagimu Extra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# Docker & Traefik Configuration
# ==============================================================================
ORIGIN=localhost
PORT=80
TRUSTED_PROXIES=*
APP_FORCE_HTTPS=false

# ==============================================================================
# Database Configuration
# ==============================================================================
# Opsi A: SQLite (Default untuk Docker Compose volume bagimu-database)
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite

# Opsi B: MySQL (Jika menggunakan MySQL di host / container lain di network backend)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bagimu_extra
# DB_USERNAME=root
# DB_PASSWORD=

# Izin menjalankan seeder demo / initial data (true / false)
ALLOW_PROD_SEED=true

# ==============================================================================
# Session, Cache, & Queue
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# Mail Configuration
# ==============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Storage / AWS S3 (Opsional)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
